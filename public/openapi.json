{
  "openapi": "3.1.0",
  "info": {
    "title": "x402-gift-agent",
    "version": "0.1.0",
    "description": "Fund someone else's agent task — buy a signed gift voucher, recipient's agent redeems it for execution with receipts\n\nPaid routes are settled with x402 (HTTP 402) in USDC on **Base or Solana** — the client picks the rail from the 402 `accepts` array.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "contact": {
      "name": "nirholas",
      "email": "nichxbt@gmail.com"
    },
    "x-guidance": "Fund someone else's agent task — buy a signed gift voucher, recipient's agent redeems it for execution with receipts. Every paid route answers an unpaid request with HTTP 402 and a list of accepted payments (USDC on Base or Solana — pick either), then returns the purchased artifact in the body of the same request once you retry with an X-PAYMENT header. Payment and delivery happen in one round trip; nothing is promised for later. POST /gifts (amount + $0.01 fee) returns signed gift voucher (claim code, task budget, expiry) POST /claim/:code (free) returns voucher validation + spendable credit record"
  },
  "servers": [
    {
      "url": "http://localhost:4022",
      "description": "Local development"
    },
    {
      "url": "https://{host}",
      "description": "Self-hosted",
      "variables": {
        "host": {
          "default": "example.com"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "paid",
      "description": "x402-paid routes — the artifact is returned in the 200 body"
    },
    {
      "name": "free",
      "description": "Free routes"
    }
  ],
  "paths": {
    "/gifts": {
      "post": {
        "summary": "Buy a gift voucher. Costs the gift amount plus a $0.01 fee; returns the signed voucher including its secret claim code.",
        "description": "Buy a gift voucher. Costs the gift amount plus a $0.01 fee; returns the signed voucher including its secret claim code. Paid: $0.11 (gift amount + $0.01 fee — e.g. `?amount=0.10`) in USDC on Base or Solana (x402).",
        "operationId": "buyGift",
        "tags": [
          "paid"
        ],
        "responses": {
          "201": {
            "description": "Signed gift voucher (claim code, task budget, expiry)",
            "headers": {
              "X-PAYMENT-RESPONSE": {
                "description": "Base64 settlement receipt: { rail, network, transaction, payer }",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "voucherId": {
                      "type": "string"
                    },
                    "document": {
                      "const": "x402-gift-agent/voucher"
                    },
                    "claimCode": {
                      "type": "string",
                      "description": "Secret redemption code — returned only to the buyer"
                    },
                    "taskBudget": {
                      "type": "string"
                    },
                    "feePaid": {
                      "type": "string"
                    },
                    "totalPaid": {
                      "type": "string"
                    },
                    "sponsor": {
                      "type": "object",
                      "description": "Dual-rail wallet identity",
                      "properties": {
                        "rail": {
                          "type": "string",
                          "enum": [
                            "evm",
                            "solana"
                          ]
                        },
                        "address": {
                          "type": "string",
                          "description": "Lowercased 0x address, or base58 Solana pubkey"
                        }
                      }
                    },
                    "boundTo": {
                      "type": "object",
                      "description": "Dual-rail wallet identity",
                      "properties": {
                        "rail": {
                          "type": "string",
                          "enum": [
                            "evm",
                            "solana"
                          ]
                        },
                        "address": {
                          "type": "string",
                          "description": "Lowercased 0x address, or base58 Solana pubkey"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    },
                    "taskHint": {
                      "type": "string"
                    },
                    "issuedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "unclaimed",
                        "claimed",
                        "expired"
                      ]
                    },
                    "signature": {
                      "type": "string"
                    },
                    "algorithm": {
                      "const": "HMAC-SHA256"
                    }
                  }
                },
                "example": {
                  "voucherId": "gift_1c9d7f22-0b3e-4c5a-9f11-77a2d0e4bb31",
                  "document": "x402-gift-agent/voucher",
                  "claimCode": "GIFT-4A7C-19F0-B3D2",
                  "taskBudget": "$0.50",
                  "feePaid": "$0.01",
                  "totalPaid": "$0.51",
                  "sponsor": {
                    "rail": "evm",
                    "address": "0x40252cfdf8b20ed757d61ff157719f33ec332402"
                  },
                  "boundTo": {
                    "rail": "solana",
                    "address": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW"
                  },
                  "message": "Happy birthday — have your agent book us dinner!",
                  "taskHint": "restaurant booking, 2 people, Friday",
                  "issuedAt": "2026-01-01T00:00:00.000Z",
                  "expiresAt": "2026-01-31T00:00:00.000Z",
                  "status": "unclaimed",
                  "signature": "7b21…hex hmac…",
                  "algorithm": "HMAC-SHA256",
                  "settlement": {
                    "rail": "evm",
                    "network": "base-sepolia",
                    "transaction": "0xabc…",
                    "payer": "0xPayer…",
                    "amount": "510000"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment required — dual-rail x402 challenge listing a Base (EVM) and a Solana entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentRequired"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "Gift budget in USD. Only honoured when no ?amount= query parameter was sent on the paid request.",
                    "example": "0.25"
                  },
                  "sponsor": {
                    "type": "string"
                  },
                  "recipient": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "taskHint": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              },
              "example": {
                "sponsor": "0x40252CFDF8B20Ed757D61ff157719F33Ec332402",
                "recipient": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW",
                "message": "Happy birthday — have your agent book us dinner!",
                "taskHint": "restaurant booking, 2 people, Friday"
              }
            }
          }
        },
        "x-payment-info": {
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.110000"
          },
          "protocols": [
            {
              "x402": {}
            }
          ]
        },
        "parameters": [
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "description": "Gift budget in USD, clamped to $0.01–$5.00 (default $0.10). Send it in the query string: the 402 challenge is built before the request body is read, so this is what lets the quote be amount + $0.01 fee.",
            "schema": {
              "type": "string",
              "example": "0.25"
            }
          }
        ]
      }
    },
    "/claim/{code}": {
      "post": {
        "summary": "Redeem a claim code against a wallet. Free — the sponsor already paid. Returns voucher validation plus a signed spendable credit record.",
        "description": "Redeem a claim code against a wallet. Free — the sponsor already paid. Returns voucher validation plus a signed spendable credit record. Free.",
        "operationId": "claimVoucher",
        "tags": [
          "free"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The `claimCode` from the voucher, e.g. `GIFT-4A7C-19F0-B3D2`"
          }
        ],
        "responses": {
          "200": {
            "description": "Voucher validation + signed spendable credit record",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "voucher": {
                      "type": "object",
                      "description": "The voucher, with claimCode redacted"
                    },
                    "credit": {
                      "type": "object",
                      "properties": {
                        "creditId": {
                          "type": "string"
                        },
                        "document": {
                          "const": "x402-gift-agent/credit"
                        },
                        "voucherId": {
                          "type": "string"
                        },
                        "budget": {
                          "type": "string"
                        },
                        "claimedBy": {
                          "type": "object",
                          "description": "Dual-rail wallet identity",
                          "properties": {
                            "rail": {
                              "type": "string",
                              "enum": [
                                "evm",
                                "solana"
                              ]
                            },
                            "address": {
                              "type": "string",
                              "description": "Lowercased 0x address, or base58 Solana pubkey"
                            }
                          }
                        },
                        "claimedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "status": {
                          "const": "active"
                        },
                        "redemption": {
                          "type": "string"
                        },
                        "signature": {
                          "type": "string"
                        },
                        "algorithm": {
                          "const": "HMAC-SHA256"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "voucher": {
                    "voucherId": "gift_1c9d7f22-0b3e-4c5a-9f11-77a2d0e4bb31",
                    "document": "x402-gift-agent/voucher",
                    "taskBudget": "$0.50",
                    "feePaid": "$0.01",
                    "totalPaid": "$0.51",
                    "sponsor": {
                      "rail": "evm",
                      "address": "0x40252cfdf8b20ed757d61ff157719f33ec332402"
                    },
                    "boundTo": {
                      "rail": "solana",
                      "address": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW"
                    },
                    "message": "Happy birthday — have your agent book us dinner!",
                    "taskHint": "restaurant booking, 2 people, Friday",
                    "issuedAt": "2026-01-01T00:00:00.000Z",
                    "expiresAt": "2026-01-31T00:00:00.000Z",
                    "status": "claimed",
                    "signature": "7b21…hex hmac…",
                    "algorithm": "HMAC-SHA256"
                  },
                  "credit": {
                    "creditId": "cred_ab77e310-4c21-4f0d-9a3b-2e5c6d7f8091",
                    "document": "x402-gift-agent/credit",
                    "voucherId": "gift_1c9d7f22-0b3e-4c5a-9f11-77a2d0e4bb31",
                    "budget": "$0.50",
                    "claimedBy": {
                      "rail": "solana",
                      "address": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW"
                    },
                    "claimedAt": "2026-01-02T00:00:00.000Z",
                    "status": "active",
                    "redemption": "Present this signed credit to the sponsor's chosen executor, or spend the budget via any x402 client funded for the task. The credit proves the gift was claimed by solana wallet WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW.",
                    "signature": "e4f0…hex hmac…",
                    "algorithm": "HMAC-SHA256"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not an EVM address or Solana pubkey",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Voucher is bound to a different wallet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown claim code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Voucher was already redeemed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Voucher past its expiry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "wallet"
                ],
                "properties": {
                  "wallet": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "wallet": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW"
              }
            }
          }
        },
        "security": []
      }
    },
