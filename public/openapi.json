                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/credits/{wallet}": {
      "get": {
        "summary": "Every signed credit record held by one wallet, on whichever rail it lives.",
        "description": "Every signed credit record held by one wallet, on whichever rail it lives. Free.",
        "operationId": "creditsForWallet",
        "tags": [
          "free"
        ],
        "parameters": [
          {
            "name": "wallet",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "EVM address or Solana pubkey"
          }
        ],
        "responses": {
          "200": {
            "description": "Signed credit records owned by that wallet",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "wallet": {
                      "type": "string"
                    },
                    "credits": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                },
                "example": {
