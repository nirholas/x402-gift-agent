        "summary": "Vouchers issued, vouchers claimed, total gifted, and claims split by rail.",
        "description": "Vouchers issued, vouchers claimed, total gifted, and claims split by rail. Free.",
        "operationId": "stats",
        "tags": [
          "free"
        ],
        "responses": {
          "200": {
            "description": "Aggregate counters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "issued": {
                      "type": "integer"
                    },
                    "claimed": {
                      "type": "integer"
                    },
                    "totalGifted": {
                      "type": "string"
                    },
                    "byRail": {
                      "type": "object"
                    }
                  }
                },
                "example": {
                  "issued": 12,
                  "claimed": 7,
                  "totalGifted": "$4.10",
                  "byRail": {
                    "evm": 5,
                    "solana": 2
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/verify": {
