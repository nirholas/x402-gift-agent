        "summary": "Verify the HMAC-SHA256 signature of any voucher or credit issued by this service.",
        "description": "Verify the HMAC-SHA256 signature of any voucher or credit issued by this service. Free.",
        "operationId": "verifyArtifact",
        "tags": [
          "free"
        ],
